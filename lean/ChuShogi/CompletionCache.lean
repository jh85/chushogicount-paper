import ChuShogi.CompletionArithmetic
import ChuShogi.ValueCache

/-! Shared uu and individual-completion caches. Missing keys compute the
verified formula, so correctness never assumes a supplied cache covers all
states. Cache values themselves are generated by the checked memo traversal. -/
namespace ChuShogi.CompletionCache
open ConcreteDP EGFConvolution

def uValue (cs : List (Degree × Nat)) (c : MemoizedSum.Cache) (xs : List Nat) : Nat :=
  (MemoizedSum.get (CachedArithmetic.fromCoefficients cs) c xs).1

def shape (s : Summary) : List Nat := [s.cb,s.cw,s.joint,s.bL,s.wL,s.bRC,s.wRC,s.bGB,s.wGB]
def decodeShape (xs : List Nat) : Summary :=
  ⟨0,0,xs[0]?.getD 0,xs[1]?.getD 0,xs[2]?.getD 0,0,0,
    xs[3]?.getD 0,xs[4]?.getD 0,xs[5]?.getD 0,xs[6]?.getD 0,xs[7]?.getD 0,xs[8]?.getD 0⟩
def polynomialReference (xs : List Nat) : List (Nat × Nat) := PromotedCoefficientSupport.labelled (decodeShape xs)

theorem shape_correct (s : Summary) : polynomialReference (shape s)=PromotedCoefficientSupport.labelled s := rfl

def completionReference (cs : List (Degree × Nat)) (c : MemoizedSum.Cache)
    (poly : ValueCache.Cache (List (Nat × Nat))) (xs : List Nat) : Nat :=
  let s := SummaryCode.decode xs
  (((ValueCache.get polynomialReference poly (shape s)).1).map fun e => e.2*uValue cs c [s.d0,s.d1,e.1]).sum

theorem completionReference_eq (cs : List (Degree × Nat)) (c : MemoizedSum.Cache)
    (poly : ValueCache.Cache (List (Nat × Nat))) (hp : ValueCache.Sound polynomialReference poly) (xs : List Nat) :
    completionReference cs c poly xs=CompletionArithmetic.withU (uValue cs c) (SummaryCode.decode xs) := by
  rw [completionReference,(ValueCache.get_correct polynomialReference poly hp _).1,shape_correct]
  rfl

structure Prepared (r : Bool) where
  coefficients : List (Degree × Nat)
  coefficients_eq : coefficients=FreeEGF.labelledCoefficients r
  uu : MemoizedSum.Cache
  uu_sound : MemoizedSum.Sound (CachedArithmetic.fromCoefficients coefficients) uu
  polynomials : ValueCache.Cache (List (Nat × Nat))
  polynomials_sound : ValueCache.Sound polynomialReference polynomials
  completions : MemoizedSum.Cache
  completions_sound : MemoizedSum.Sound (completionReference coefficients uu polynomials) completions

def queriesU : List (List Nat × Nat) :=
  (EfficientCounter.queries ReducedTables.table).map fun e => (e.1,0)

@[noinline] def prepare (r : Bool) (rows : WeightedDP.Table (List Nat)) : Prepared r :=
  let cs := FreeEGF.labelledCoefficients r
  let uc := (MemoizedSum.run (CachedArithmetic.fromCoefficients cs) queriesU ∅ 0).2
  have hu : MemoizedSum.Sound (CachedArithmetic.fromCoefficients cs) uc := by
    apply (MemoizedSum.run_correct _ _ _ _ _).2
    intro k v h; simp at h
  let pc := ValueCache.prepare polynomialReference (rows.map fun e => shape (SummaryCode.decode e.1))
  have hp := ValueCache.prepare_sound polynomialReference (rows.map fun e => shape (SummaryCode.decode e.1))
  let queries := rows.map fun e => (e.1,0)
  let fc := (MemoizedSum.run (completionReference cs uc pc) queries ∅ 0).2
  have hf : MemoizedSum.Sound (completionReference cs uc pc) fc := by
    apply (MemoizedSum.run_correct _ _ _ _ _).2
    intro k v h; simp at h
  ⟨cs,rfl,uc,hu,pc,hp,fc,hf⟩

@[noinline] def finish (p : Prepared r) (s : Summary) : Nat :=
  (MemoizedSum.get (completionReference p.coefficients p.uu p.polynomials) p.completions (SummaryCode.encode s)).1

theorem finish_correct (p : Prepared r) (s : Summary) : finish p s=EvaluatorRefinement.evaluateNat r s := by
  rw [finish,(MemoizedSum.get_correct _ _ p.completions_sound _).1]
  rw [completionReference_eq _ _ _ p.polynomials_sound]
  simp only [SummaryCode.decode_encode]
  rw [← CompletionArithmetic.evaluate_correct]
  apply congrArg (fun u => CompletionArithmetic.withU u s)
  funext xs
  rw [uValue,(MemoizedSum.get_correct _ _ p.uu_sound _).1,p.coefficients_eq]
  exact congrFun (CachedArithmetic.unrestricted_correct r) xs

end ChuShogi.CompletionCache
